# TG100 Connection
TG100_HOST=192.168.1.100
TG100_PORT=5038
TG100_USERNAME=admin
TG100_PASSWORD=secret

# Remote API
API_URL=https://api.example.com/sms/incoming
API_BEARER_TOKEN=your-bearer-token-here

# Security
HMAC_SECRET_KEY=your-hmac-secret-key

# Retry Configuration (optional, defaults provided)
INITIAL_RETRY_DELAY=5
MAX_RETRY_DELAY=60

# Keepalive Configuration (optional)
PING_INTERVAL=300  # Send AMI Ping every N seconds (0 to disable, default: 300)

# Logging Configuration (optional)
# LOG_LEVEL=DEBUG  # Options: DEBUG, INFO, WARNING, ERROR
# Use DEBUG to see detailed protocol messages from TG100
