# TG100 Connection
TG100_HOST=192.168.1.100
TG100_PORT=5038
TG100_USERNAME=admin
TG100_PASSWORD=secret

# Delivery mode (optional, default: telegram)
#   telegram - send SMS straight to Telegram Bot API
#   relay    - legacy: send signed SMS to the relay server (gsm-to-telegram-bot)
# Can be overridden at start: python main.py --mode relay
DELIVERY_MODE=telegram

# Telegram (required in telegram mode)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
# TELEGRAM_REQUEST_TIMEOUT=15

# Remote API (required in relay mode)
API_URL=https://api.example.com/sms/incoming
API_BEARER_TOKEN=your-bearer-token-here

# Security (required in relay mode)
HMAC_SECRET_KEY=your-hmac-secret-key

# Retry Configuration (optional, defaults provided)
INITIAL_RETRY_DELAY=5
MAX_RETRY_DELAY=60

# Keepalive Configuration (optional)
PING_INTERVAL=300  # Send AMI Ping every N seconds (0 to disable, default: 300)

# Message queue (optional, default: queue.db in the working directory)
# SQLite file: SMS waiting for delivery survive a restart
# QUEUE_DB_PATH=queue.db

# Logging Configuration (optional)
# LOG_LEVEL=DEBUG  # Options: DEBUG, INFO, WARNING, ERROR
# Use DEBUG to see detailed protocol messages from TG100
